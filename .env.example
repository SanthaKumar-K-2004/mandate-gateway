# Mandate Gateway — Environment Configuration Template
# Copy this file to .env for local development. DO NOT commit actual secrets to version control.

# Application Configuration
APP_ENV=development
APP_NAME=mandate-gateway
LOG_LEVEL=INFO

# Infrastructure Host Boundary (false for container Compose mode, true for host machine execution)
HOST_CONTEXT=false

# Database Infrastructure Configuration (PostgreSQL 16)
# Container Compose context uses POSTGRES_HOST=postgres (postgres:5432)
# Host machine context uses POSTGRES_HOST=127.0.0.1 (127.0.0.1:5432)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mandate_gateway
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY

# Redis Infrastructure Configuration (Redis 7)
# Container Compose context uses REDIS_HOST=redis (redis:6379)
# Host machine context uses REDIS_HOST=127.0.0.1 (127.0.0.1:6379)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# AI LLM Gateway & Real-Time Product Discovery Configuration
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

LIVE_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=your_tavily_api_key_here
LIVE_SEARCH_FALLBACK_PROVIDER=brave
BRAVE_SEARCH_API_KEY=your_brave_api_key_here

